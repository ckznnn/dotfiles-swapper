{
    // ============================================================
    //  Waybar Configuration
    //  Modules: workspaces, rofi, window title, clock, wifi,
    //           pulseaudio, bluetooth
    // ============================================================
    
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    // ----- Module Layout ----------------------------------------
    "modules-left": [
        "hyprland/workspaces",
        "custom/rofi"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "bluetooth",
        "clock"
    ],

    // ============================================================
    //  LEFT MODULES
    // ============================================================

    // --- Workspaces (Hyprland) -----------------------------------
    // Change to "sway/workspaces" if you use Sway
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        },
        // Only show workspaces 1-4
        "active-only": false,
        "all-outputs": false
    },

    // --- Rofi Launcher ------------------------------------------
    "custom/rofi": {
        "format": " ",
        "tooltip": "Application Launcher",
        "on-click": "rofi -show drun"
    },

    // ============================================================
    //  CENTER MODULES
    // ============================================================

    // --- Focused Window Title (scrolling) -----------------------
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            // Strip common suffixes — customise as you like
            "(.*) — Mozilla Firefox": "🌐 $1",
            "(.*) - Visual Studio Code": "💻 $1",
            "": "Desktop"
        },
        "separate-outputs": false,
        // Waybar truncates long titles; pair with CSS animation
        // for a marquee effect (see style.css)
        "max-length": 60
    },

    // ============================================================
    //  RIGHT MODULES
    // ============================================================

    // --- Network / Wi-Fi ----------------------------------------
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰖪  Offline",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
        // Change the on-click command to your preferred network manager
        // e.g. "on-click": "kitty -e nmtui"
    },

    // --- Audio (PulseAudio / PipeWire) --------------------------
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
    },

    // --- Bluetooth ----------------------------------------------
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "format-off": "󰂲",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
        // Change to your preferred bluetooth manager if needed
    },

    // --- Clock --------------------------------------------------
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": ""
        // Left-click cycles between time and date formats
    }
}
