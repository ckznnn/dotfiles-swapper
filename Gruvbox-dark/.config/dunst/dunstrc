# ============================================================
#  dunstrc — Dunst Notification Daemon Config — Gruvbox Dark
# ============================================================
#
#  COLOUR REFERENCE
#
#  Low urgency      bg=#282828  fg=#ebdbb2  frame=#504945
#  Normal urgency   bg=#282828  fg=#ebdbb2  frame=#d79921
#  Critical urgency bg=#282828  fg=#cc241d  frame=#cc241d
#
# ============================================================
# ============================================================
#  GLOBAL SETTINGS
# ============================================================
[global]
    # --- Position & Size ---
    origin           = top-right
    offset           = (10, 40)
    width            = 300
    height           = (0, 200)
    gap_size         = 6
    # --- Notification Behaviour ---
    timeout          = 5
    stack_duplicates = true
    sticky_history   = yes
    history_length   = 20
    # --- Appearance ---
    corner_radius    = 8
    frame_width      = 2
    separator_height = 2
    padding          = 10
    horizontal_padding = 12
    # --- Font ---
    font             = JetBrains Mono 10
    # --- Icons ---
    icon_position    = left
    min_icon_size    = 32
    max_icon_size    = 64
    # --- Markup & Text ---
    markup           = full
    format           = "<b>%s</b>\n%b"
    word_wrap        = yes
    ellipsize        = middle
    # --- Mouse Actions ---
    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all
    # --- Misc ---
    follow           = mouse
    sort             = yes
# ============================================================
#  URGENCY LEVELS
# ============================================================
[urgency_low]
    background  = "#282828"
    foreground  = "#ebdbb2"
    frame_color = "#504945"
    timeout     = 4

[urgency_normal]
    background  = "#282828"
    foreground  = "#ebdbb2"
    frame_color = "#d79921"
    timeout     = 5

[urgency_critical]
    background  = "#282828"
    foreground  = "#cc241d"
    frame_color = "#cc241d"
    timeout     = 0
# ============================================================
#  CUSTOM RULES (MODULES)
# ============================================================
[play_sound]
    summary = "*"
    script = ~/.config/dunst/notify-sound.sh

# --- Volume / Audio notifications ---
[volume]
    appname        = dunst-volume
    summary        = "Volume*"
    background     = "#282828"
    foreground     = "#98971a"      # gruvbox green
    frame_color    = "#98971a"
    timeout        = 2
    history_ignore = yes

# --- Battery warnings ---
[battery_low]
    appname        = upower
    summary        = "*Low*"
    background     = "#282828"
    foreground     = "#fe8019"      # gruvbox orange
    frame_color    = "#fe8019"
    urgency        = critical

# --- Screenshot confirmations ---
[screenshot]
    appname        = flameshot
    background     = "#282828"
    foreground     = "#b16286"      # gruvbox purple
    frame_color    = "#b16286"
    timeout        = 3

# --- Music / Media player ---
[media]
    appname        = "playerctl"
    background     = "#282828"
    foreground     = "#689d6a"      # gruvbox aqua
    frame_color    = "#689d6a"
    timeout        = 3

# --- Calendar / Reminder apps ---
[reminder]
    category       = "reminder"
    background     = "#282828"
    foreground     = "#d79921"      # gruvbox yellow
    frame_color    = "#d79921"
    timeout        = 0
# ============================================================
#  END OF CONFIG
#  Save to ~/.config/dunst/dunstrc then restart dunst:
#    killall dunst && dunst &
# ============================================================
